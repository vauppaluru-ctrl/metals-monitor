<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>

    <key>Label</key>
    <string>com.local.metalswebserver</string>

    <key>ProgramArguments</key>
    <array>
        <string>{{PYTHON_PATH}}</string>
        <string>{{WEB_SERVER_PATH}}</string>
    </array>

    <key>WorkingDirectory</key>
    <string>{{PROJECT_DIR}}</string>

    <!-- Keep the web server alive: launchd restarts it if it exits for any reason -->
    <key>KeepAlive</key>
    <true/>

    <!-- Start immediately on login / launchd load -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{LOG_DIR}}/metals_webserver_stdout.log</string>

    <key>StandardErrorPath</key>
    <string>{{LOG_DIR}}/metals_webserver_stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <!-- Built-in scheduler runs the monitor every hour; no separate LaunchAgent needed -->
        <key>SCHEDULER_ENABLED</key>
        <string>true</string>
    </dict>

    <key>ProcessType</key>
    <string>Background</string>

    <!-- Prevent rapid crash-restart loops -->
    <key>ThrottleInterval</key>
    <integer>30</integer>

</dict>
</plist>
